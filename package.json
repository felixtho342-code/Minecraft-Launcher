{
  "name": "prismclient",
  "version": "1.0.4",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "description": "PrismClient launcher for Minecraft Java Edition",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis"
  },
  "dependencies": {
    "@xmcl/core": "2.13.0",
    "@xmcl/installer": "5.4.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "electron": "^45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2",
    "undici": "6.28.1",
    "@fastify/busboy": "3.2.2",
    "@noble/hashes": "1.8.0"
  }
}
